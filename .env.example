# Infra secrets only — never put user AI keys here.
SECRET_KEY=django-dev-secret-key-change-me-ai-book-reader-32chars
DEBUG=true
FIELD_ENCRYPTION_KEY=change-me-to-a-long-random-string-for-fernet
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Leave unset to use SQLite for local development
# POSTGRES_DB=aibook
# POSTGRES_USER=aibook
# POSTGRES_PASSWORD=aibook
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
# true = process PDFs in the web process (no Redis worker needed)
CELERY_TASK_ALWAYS_EAGER=true

MAX_UPLOAD_SIZE_MB=50

# Optional Google Sign-In
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
